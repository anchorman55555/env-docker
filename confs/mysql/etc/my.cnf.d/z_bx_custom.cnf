[mysqld]
# PERFORMANCE TUNING: 64GB RAM / 30-core Xeon 8592+

# InnoDB Buffer Pool - 40GB (62% RAM)
innodb_buffer_pool_size = 40G
innodb_buffer_pool_instances = 16

# Redo log was 100MB - bumped to 4GB for write throughput
innodb-redo-log-capacity = 4294967296

# I/O tuning for NVMe (xvdc)
innodb_io_capacity = 4000
innodb_io_capacity_max = 8000
innodb_read_io_threads = 16
innodb_write_io_threads = 8
innodb_purge_threads = 4
innodb_lru_scan_depth = 256
innodb_flush_method = O_DIRECT

# Connections - 30 cores, 100 PHP-FPM workers + headroom
max_connections = 300
thread_cache_size = 64

# Per-session buffers (conservative: 300 conn * 4M = 1.2GB max)
sort_buffer_size = 4M
join_buffer_size = 4M
read_buffer_size = 2M
read_rnd_buffer_size = 4M

# Temp tables
tmp_table_size = 256M
max_heap_table_size = 256M

# Packet size
max_allowed_packet = 256M

# Consistent collation init
init-connect = "SET NAMES utf8mb4 COLLATE utf8mb4_unicode_ci"

# tmpdir on NVMe LV (20G, faster than container tmpfs for large sorts)
tmpdir = /var/lib/mysql/tmp

# Override secure-log-path so logs can go to /var/log/mysql
secure-log-path=/var/log/mysql

# Logging (mounted volume: /mnt/bitrix/logs/mysql)
log_error = /var/log/mysql/error.log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1

# Character set
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

[client]
default-character-set = utf8mb4
